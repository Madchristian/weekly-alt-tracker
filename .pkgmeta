package-as: WeeklyAltTracker

enable-nolib-creation: no

# Kanonische kumulative Release-Historie statt automatisch erzeugter Commitliste.
# CHANGELOG.md wird von tools/generate_changelog.py deterministisch aus den
# zweisprachigen Paaren changelog/CHANGELOG-<version>-en.md und -de.md
# erzeugt (je Version einmal, zuerst Englisch, dann Deutsch) und nie von Hand
# bearbeitet; tools/check.py und die Release-Workflows pruefen das fail-closed.
# Die skalare Form ist die gemeinsame Schnittmenge des BigWigs-Packagers und
# des CurseForge-Repository-Packagers; die verschachtelte BigWigs-Form wird von
# CurseForge ignoriert.
manual-changelog: CHANGELOG.md

ignore:
  - .github
  - .gitignore
  - .gitattributes
  - .pkgmeta
  - .claude
  - CLAUDE.md
  - artwork
  - backups
  - design
  - dist
  - releases
  - .release
  - tools
  - wago
  - curseforge
  - changelog
  - Media/README.md
